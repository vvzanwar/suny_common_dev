<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active_To_Date_Greater_Than_From_Date</fullName>
    <active>true</active>
    <description>Ensures that Active To Date is strictly greater than Active From Date.</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(ActiveFromDate)),
    NOT(ISBLANK(ActiveToDate)),
    ActiveToDate &lt;= ActiveFromDate
)</errorConditionFormula>
    <errorDisplayField>ActiveToDate</errorDisplayField>
    <errorMessage>Active To Date must be later than Active From Date.</errorMessage>
</ValidationRule>
